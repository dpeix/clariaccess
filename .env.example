# Copy to .env (git-ignored) and adjust. Never commit real secrets.

# --- Docker Compose (PostgreSQL) ---
POSTGRES_USER=accessibility
POSTGRES_PASSWORD=change-me
POSTGRES_DB=accessibility

# --- apps/api and apps/worker (validated with Zod at startup) ---
NODE_ENV=development
# Must match the POSTGRES_* values above.
DATABASE_URL=postgres://accessibility:change-me@localhost:5432/accessibility

# --- apps/api only ---
HOST=127.0.0.1
PORT=3000
# Mailpit from docker-compose in development; a real SMTP URL in production.
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=audit@example.fr
# Origin of the public site: the report link in emails is <origin>/audit/?id=<id>.
PUBLIC_SITE_URL=http://localhost:4321
# Origin of the customer app (apps/app): target of the login link and the only
# browser origin allowed to make signed-in requests.
APP_URL=http://localhost:5173
# Login link requests per IP (defaults shown).
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=3600
# Set to true only behind a reverse proxy you control (X-Forwarded-For is then
# trusted for per-IP rate limiting).
# TRUST_PROXY=false
# Requests per IP on POST /audits/free and POST /leads, over the window below.
# RATE_LIMIT_IP_MAX=10
# RATE_LIMIT_IP_WINDOW_SECONDS=3600
# Multi-page audits per site over 24 hours (customer accounts).
# SITE_DAILY_AUDIT_LIMIT=5
# Free audits per domain over 24 hours, whoever asks.
# DOMAIN_DAILY_AUDIT_LIMIT=3

# --- apps/worker only (optional, defaults shown) ---
# Wall-clock budget for one audit, in milliseconds.
# AUDIT_TIMEOUT_MS=60000
# Maximum number of issues stored per audit.
# AUDIT_MAX_ISSUES=2000
# Pages scanned per multi-page audit, home page included.
# CRAWL_MAX_PAGES=25
# Pages still waiting after this long (ms) are abandoned.
# CRAWL_MAX_DURATION_MS=600000
# How often the scheduler looks for re-scans that came due (cron, UTC), and how
# many it starts per tick.
# SCAN_TICK_CRON=*/5 * * * *
# SCAN_TICK_BATCH=20

# --- apps/site (public, build time) ---
# Origin of the API; it must allow PUBLIC_SITE_URL (CORS).
PUBLIC_API_URL=http://localhost:3000

# --- apps/app (public, build time) ---
# Origin of the API; it must allow APP_URL (CORS with credentials).
VITE_API_URL=http://localhost:3000


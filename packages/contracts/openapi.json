{
  "openapi": "3.1.0",
  "info": {
    "title": "Accessibility API",
    "version": "0.0.0"
  },
  "components": {
    "schemas": {
      "Audit": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "type": {
            "$ref": "#/components/schemas/AuditType"
          },
          "status": {
            "$ref": "#/components/schemas/AuditStatus"
          },
          "startedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "finishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "pagesScanned": {
            "type": "integer",
            "minimum": 0
          },
          "score": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "failureReason": {
            "$ref": "#/components/schemas/AuditFailureReason"
          }
        },
        "required": [
          "id",
          "url",
          "type",
          "status",
          "startedAt",
          "finishedAt",
          "pagesScanned",
          "score",
          "failureReason"
        ]
      },
      "AuditType": {
        "type": "string",
        "enum": [
          "free",
          "scheduled",
          "manual"
        ]
      },
      "AuditStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "completed",
          "failed"
        ]
      },
      "AuditFailureReason": {
        "type": [
          "string",
          "null"
        ],
        "enum": [
          "forbidden_url",
          "robots_disallowed",
          "scan_failed",
          null
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "message"
        ]
      },
      "FreeAuditRequest": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "url"
        ]
      },
      "AuditReport": {
        "type": "object",
        "properties": {
          "audit": {
            "$ref": "#/components/schemas/Audit"
          },
          "totalIssues": {
            "type": "integer",
            "minimum": 0
          },
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportGroup"
            }
          },
          "automatedCoverageNotice": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "audit",
          "totalIssues",
          "groups",
          "automatedCoverageNotice"
        ]
      },
      "ReportGroup": {
        "type": "object",
        "properties": {
          "ruleId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "helpUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "impact": {
            "$ref": "#/components/schemas/Impact"
          },
          "occurrences": {
            "type": "integer",
            "minimum": 1
          },
          "examples": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportExample"
            }
          },
          "wcagCriteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rgaaCriteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ruleId",
          "title",
          "helpUrl",
          "impact",
          "occurrences",
          "examples",
          "wcagCriteria",
          "rgaaCriteria"
        ]
      },
      "Impact": {
        "type": "string",
        "enum": [
          "minor",
          "moderate",
          "serious",
          "critical"
        ]
      },
      "ReportExample": {
        "type": "object",
        "properties": {
          "selector": {
            "type": "string"
          },
          "htmlExcerpt": {
            "type": "string"
          }
        },
        "required": [
          "selector",
          "htmlExcerpt"
        ]
      },
      "LeadRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "auditId": {
            "type": "string",
            "format": "uuid"
          },
          "consent": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "utm": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "email",
          "auditId",
          "consent"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/audits/free": {
      "post": {
        "summary": "Start a free audit of a public URL",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FreeAuditRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Audit queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Audit"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/audits/{id}": {
      "get": {
        "summary": "Get the status of an audit",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Audit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Audit"
                }
              }
            }
          },
          "404": {
            "description": "Audit not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/audits/{id}/report": {
      "get": {
        "summary": "Get the report of a completed audit",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditReport"
                }
              }
            }
          },
          "404": {
            "description": "Audit not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Audit not completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/leads": {
      "post": {
        "summary": "Record a lead with explicit consent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeadRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Lead recorded"
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}

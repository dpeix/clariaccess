{
  "name": "@accessibility/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "set-plan": "tsx --env-file-if-exists=../../.env src/billing/set-plan-cli.ts"
  },
  "dependencies": {
    "@accessibility/contracts": "workspace:*",
    "@accessibility/db": "workspace:*",
    "@accessibility/queue": "workspace:*",
    "@accessibility/rules": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "nodemailer": "10.0.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/nodemailer": "8.0.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
